.ruff_cache/

# Node (in case we go TS)
node_modules/
dist/
*.log

# Local state / caches (regenerable — keep out of git)
*.sqlite
*.sqlite3
*.db
cache/
.cache/
outputs/*.tmp
tmp/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Excel lock/temp files
~$*

# generated pipeline outputs
outputs/*
!outputs/.gitkeep

revision_manual