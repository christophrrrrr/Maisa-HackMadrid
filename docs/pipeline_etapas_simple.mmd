%% simplified pitch diagram: llm extracts, rules decide
%%{init: {
    "flowchart": {"nodeSpacing": 90, "rankSpacing": 70, "diagramPadding": 20},
    "themeVariables": {"fontSize": "32px"},
    "themeCSS": ".nodeLabel p, .edgeLabel p { font-size: 32px !important; line-height: 1.25; } .cluster-label span { font-size: 30px !important; }"
}}%%
flowchart LR
    invoices[/"Facturas"/]

    subgraph extract ["1. Extraccion"]
        direction TB
        hybrid{"Hibrido"}
        digital["PDF<br/>digital"]
        vision["Vision<br/>LLM"]
        invoice["Invoice<br/>Data"]
        hybrid -->|"Gratis"| digital
        hybrid -->|"Escaneado"| vision
        digital --> invoice
        vision --> invoice
    end

    subgraph refs ["Datos de referencia"]
        direction TB
        excel["Excel<br/>maestros"]
        erp[("Snapshot<br/>ERP")]
        biz["Pedidos<br/>y norma"]
        excel --> biz
        erp --> biz
    end

    subgraph decide ["2. Decision"]
        direction TB
        rules["Motor<br/>Norma v3"]
        checks["6 checks<br/>auditables"]
        result{"PAGAR / NO_PAGAR / ESCALAR"}
        rules --> checks
        checks --> result
    end

    subgraph emit ["3. Entregable"]
        direction TB
        state[("SQLite")]
        jsonl[/"outcomes.<br/>jsonl"/]
        ui["Consola de<br/>revision"]
        state --> ui
        jsonl --> ui
    end

    invoices ==> hybrid
    invoice ==> rules
    biz --> rules
    result ==> state
    result ==> jsonl

    style extract fill:#C2E5FF,stroke:#3DADFF
    style refs fill:#FFECBD,stroke:#FFC943
    style decide fill:#DCCCFF,stroke:#874FFF
    style emit fill:#CDF4D3,stroke:#66D575
